<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="8.0.3" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lokal import-bhk əmri üçün output-a kopyalanır, amma PUBLISH-ə DÜŞMÜR:
         bu fayllarda 388 kursantın real şəxsi məlumatı var (ad, FİN, iş nömrəsi,
         bal). Publish çıxışı və Docker image üçüncü şəxslərə verilir. -->
    <None Update="SeedData\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
    <Content Update="SeedData\*.json">
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>

    <!-- Development konfiqurasiyasında real DB parolu və JWT açarı var — bu fayl
         .gitignore-dadır, publish çıxışına da düşməməlidir. İstehsalda bütün
         dəyərlər env dəyişənlərindən (.env) gəlir. -->
    <Content Update="appsettings.Development.json">
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
